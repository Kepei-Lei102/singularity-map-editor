{
  "name": "ts-map-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/open.mjs",
    "dev:host": "vite --mode host",
    "dev:player": "vite --mode player",
    "build:split": "tsc --noEmit && vite build --mode host && vite build --mode player",
    "preview:host": "vite preview --mode host",
    "preview:player": "vite preview --mode player",
    "test": "node --test scripts/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:single": "tsc --noEmit && SINGLE=1 vite build --outDir release-build",
    "start": "node scripts/open.mjs"
  },
  "dependencies": {
    "immer": "10.1.1",
    "jszip": "3.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
